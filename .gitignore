# Python
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Environment file (contains API keys)
.env

# Fernet key for provider API-key encryption (never commit)
config/fernet.key

# SQLite database (generated at runtime)
chat.db
chat.db-wal
chat.db-shm

# RAG vector store & uploaded files (generated at runtime)
chroma_db/
uploads/

# User file workspace (uploads / AI generated files / exports)
workspace/

# Node.js
node_modules/

# IDE
.idea/

# AI assistant configs
.claude/

# Local project documentation (not for public repo)
PROJECT_DOC.md
*.log

# Runtime logs (rotated files have no .log suffix)
logs/

checkpoints.db
checkpoints.db-wal
checkpoints.db-shm

# Skills store (generated at runtime)
skills_store.db
skills_store.db-wal
skills_store.db-shm

# Test caches
.pytest_cache/
